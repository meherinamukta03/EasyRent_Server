# MongoDB credentials used by the Express API
DB_USER=
DB_PASSWORD=

# Server-only JWT secret. Must match JWT_SECRET in the Next.js frontend .env.
JWT_SECRET=

# Stripe (test mode). Keep these secrets on the backend only.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
FRONTEND_URL=http://localhost:3000
STRIPE_CURRENCY=usd
